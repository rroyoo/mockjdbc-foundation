<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.rroyoo.mockjdbc</groupId>
    <artifactId>mockjdbc</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>mockjdbc-proxy</module>
        <module>mockjdbc-proto</module>
        <module>mockjdbc-mock</module>
        <module>mockjdbc-wiremock</module>
    </modules>

    <name>MockJDBC Ecosystem Parent</name>
    <description>Parent POM for MockJDBC ecosystem with submodules.</description>
    <url>https://github.com/rroyoo/mockjdbc-foundation</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>rroyoo</id>
            <name>Ramón Royo</name>
            <url>https://github.com/rroyoo</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/rroyoo/mockjdbc-foundation.git</connection>
        <developerConnection>scm:git:https://github.com/rroyoo/mockjdbc-foundation.git</developerConnection>
        <url>https://github.com/rroyoo/mockjdbc-foundation</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.plugin.version.central-publishing>0.12.0</maven.plugin.version.central-publishing>
        <maven.plugin.version.compiler>3.16.0</maven.plugin.version.compiler>
        <maven.plugin.version.gpg>3.2.8</maven.plugin.version.gpg>
        <maven.plugin.version.jacoco>0.8.16</maven.plugin.version.jacoco>
        <maven.plugin.version.javadoc>3.12.0</maven.plugin.version.javadoc>
        <maven.plugin.version.os-maven>1.7.1</maven.plugin.version.os-maven>
        <maven.plugin.version.pmd>3.27.0</maven.plugin.version.pmd>
        <maven.plugin.version.protobuf>5.1.12</maven.plugin.version.protobuf>
        <maven.plugin.version.source>3.4.0</maven.plugin.version.source>
        <maven.plugin.version.spotless>3.10.3</maven.plugin.version.spotless>
        <maven.version.byte-buddy>1.18.17</maven.version.byte-buddy>
        <maven.version.grpc>1.79.0</maven.version.grpc>
        <maven.version.google-java-format>1.30.0</maven.version.google-java-format>
        <maven.version.javax-annotation-api>1.3.2</maven.version.javax-annotation-api>
        <maven.version.kafka>3.9.2</maven.version.kafka>
        <maven.version.mockito>5.24.0</maven.version.mockito>
        <maven.version.protobuf>4.36.2</maven.version.protobuf>
        <maven.version.test.junit-jupiter>5.14.4</maven.version.test.junit-jupiter>
        <maven.version.testcontainers>1.21.4</maven.version.testcontainers>
        <maven.version.wiremock>3.13.2</maven.version.wiremock>
        <!-- CI-friendly version: the first public beta line is 0.x.0-beta.N.
             The release workflow overrides this with -Drevision=<tag-derived-version>
             via flatten-maven-plugin; this SNAPSHOT value is only used for local/dev builds. -->
        <revision>0.1.0-SNAPSHOT</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-bom</artifactId>
                <version>${maven.version.protobuf}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${maven.version.grpc}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-parent</artifactId>
                <version>${maven.version.byte-buddy}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>javax.annotation</groupId>
                <artifactId>javax.annotation-api</artifactId>
                <version>${maven.version.javax-annotation-api}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${maven.version.kafka}</version>
            </dependency>

            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock</artifactId>
                <version>${maven.version.wiremock}</version>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${maven.version.testcontainers}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${maven.version.test.junit-jupiter}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${maven.version.mockito}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>kr.motd.maven</groupId>
                    <artifactId>os-maven-plugin</artifactId>
                    <version>${maven.plugin.version.os-maven}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.plugin.version.compiler}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${maven.plugin.version.protobuf}</version>
                    <configuration>
                        <protoc>${maven.version.protobuf}</protoc>
                        <plugins>
                            <plugin kind="binary-maven">
                                <groupId>io.grpc</groupId>
                                <artifactId>protoc-gen-grpc-java</artifactId>
                                <version>${maven.version.grpc}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                            <phase>
                                generate-sources
                            </phase>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} -Djdk.attach.allowAttachSelf=true</argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${maven.plugin.version.spotless}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <googleJavaFormat>
                                <version>${maven.version.google-java-format}</version>
                                <style>AOSP</style>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven.plugin.version.pmd}</version>
                    <configuration>
                        <rulesets combine.self="override">
                            <ruleset>${maven.multiModuleProjectDirectory}/../.github/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <targetJdk>${java.version}</targetJdk>
                        <includeTests>true</includeTests>
                        <failOnViolation>true</failOnViolation>
                        <failurePriority>5</failurePriority>
                        <maxAllowedViolations>0</maxAllowedViolations>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-complexity-check</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${maven.plugin.version.jacoco}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.9.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activated explicitly with -Prelease by the release GitHub Actions workflow
            (never by default local/CI builds). Produces the sources/javadoc jars and
            GPG signatures Maven Central requires, and publishes the reactor (this
            parent POM plus mockjdbc-proto, mockjdbc-mock, mockjdbc-proxy,
            mockjdbc-wiremock) through the Central Publisher Portal. GPG signing uses
            the key imported from the GPG_PRIVATE_KEY/GPG_PASSPHRASE secrets; Central
            credentials come from the "central" server id in settings.xml, populated
            from the CENTRAL_USERNAME/CENTRAL_PASSWORD secrets. autoPublish is left
            false so every beta still requires a manual publish confirmation in the
            Central Portal, per the open-source launch roadmap.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.plugin.version.source}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.plugin.version.javadoc}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.plugin.version.gpg}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${maven.plugin.version.central-publishing}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

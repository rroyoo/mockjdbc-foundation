<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>io.github.rroyoo.mockjdbc</groupId>
    <artifactId>mockjdbc-spring-users</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>mockjdbc-spring-users</name>
    <description>Independent Spring Boot users service with h2 and mockjdbc profiles</description>

    <properties>
        <java.version>17</java.version>
        <bytebuddy.version>1.18.3</bytebuddy.version>
        <datasource-proxy.version>1.11.0</datasource-proxy.version>
        <grpc.version>1.79.0</grpc.version>
        <javax.annotation.version>1.3.2</javax.annotation.version>
        <kafka.version>3.8.1</kafka.version>
        <mockjdbc.version>1.0.0-SNAPSHOT</mockjdbc.version>
        <protobuf.version>4.34.0</protobuf.version>
        <protobuf.version>4.34.0</protobuf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.rroyoo.mockjdbc</groupId>
            <artifactId>mockjdbc-mock-local</artifactId>
            <version>${mockjdbc.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../mockjdbc/mockjdbc-mock/target/mockjdbc-mock-${mockjdbc.version}.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>io.github.rroyoo.mockjdbc</groupId>
            <artifactId>mockjdbc-proto-local</artifactId>
            <version>${mockjdbc.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../mockjdbc/mockjdbc-proto/target/mockjdbc-proto-${mockjdbc.version}.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>io.github.rroyoo.mockjdbc</groupId>
            <artifactId>mockjdbc-proxy-local</artifactId>
            <version>${mockjdbc.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../mockjdbc/mockjdbc-proxy/target/mockjdbc-proxy-${mockjdbc.version}.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>${javax.annotation.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Transitive deps of mockjdbc-proxy (system-scoped JARs don't pull transitives) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>${datasource-proxy.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

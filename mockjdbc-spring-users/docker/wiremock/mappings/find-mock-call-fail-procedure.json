{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/io.github.rroyoo.mockjdbc.mock.MockQueryService/FindMock",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.sql == '{ call FAIL_PROCEDURE(?) }')]"
      },
      {
        "matchesJsonPath": "$[?(@.parameters[0].value.longVal == '999' || @.parameters[0].value.longVal == 999)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "grpc-status-name": "OK"
    },
    "jsonBody": {
      "error": {
        "type": "java.sql.SQLNonTransientException",
        "message": "procedure failed"
      }
    }
  }
}
